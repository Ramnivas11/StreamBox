generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  videos    Video[]
}


model Video {
  id          String   @id @default(uuid())
  title       String
  description String?
  videoUrl    String
  thumbnailUrl String?
  imageKitFileId String?
  duration    Int?
  size        BigInt?
  status      String   @default("READY")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id])
}